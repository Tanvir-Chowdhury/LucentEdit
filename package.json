{
  "name": "lucentedit",
  "private": true,
  "version": "0.10.0",
  "description": "LucentEdit: a free, lightweight, open-source Photoshop + Illustrator alternative with a built-in MCP server for AI agents",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:demo": "tsc --noEmit && vite build --mode demo",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "tauri": "tauri",
    "app:dev": "tauri dev",
    "app:build": "tauri build",
    "test:mcp": "node scripts/mcp-smoke-test.mjs",
    "test": "for f in src/core/*.check.ts; do tsx \"$f\" || exit 1; done"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@preact/signals": "^2.11.3",
    "@tauri-apps/api": "^2.12.3",
    "@tauri-apps/plugin-dialog": "^2.8.2",
    "ag-psd": "^31.0.3",
    "lucide-preact": "^1.55.0",
    "pdfjs-dist": "^6.3.289",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@tauri-apps/cli": "^2.12.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
